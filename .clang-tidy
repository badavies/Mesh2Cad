# CLion shows these as you type. CI runs clang-tidy once the codebase is clean (tracked in issues).
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-slicing,
  cppcoreguidelines-virtual-class-destructor,
  misc-const-correctness,
  misc-include-cleaner,
  misc-redundant-expression,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  performance-*,
  readability-container-size-empty,
  readability-delete-null-pointer,
  readability-else-after-return,
  readability-make-member-function-const,
  readability-redundant-*,
  readability-simplify-boolean-expr
HeaderFilterRegex: '.*/src/.*'
WarningsAsErrors: ''
CheckOptions:
  # Libraries whose public headers forward to internal ones: Qt's QFoo headers (emit, qRound,
  # QStringList), OpenGL through Qt, the Windows API through windows.h, and oneTBB.
  - key: misc-include-cleaner.IgnoreHeaders
    value: 'nlohmann[/\\].*;Eigen[/\\].*;miniz.*;CGAL[/\\].*;Qt[A-Za-z]*[/\\]q[a-z0-9_]*\.h;GL[/\\].*;KHR[/\\].*;[a-z]*api[a-z]*\.h;win[a-z]*\.h;minwindef\.h;tbb[/\\].*'
  # A cast to void marks a result that is deliberately dropped (best-effort calls).
  - key: bugprone-unused-return-value.AllowCastToVoid
    value: true
