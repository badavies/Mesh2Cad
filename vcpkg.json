{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "mesh2cad",
  "version": "0.1.0",
  "builtin-baseline": "44ccfd88b3eca6929d6d16398c7b19945c29a5f6",
  "vcpkg-configuration": {
    "overlay-ports": [
      "cmake/vcpkg-ports"
    ]
  },
  "dependencies": [
    "nlohmann-json",
    "eigen3",
    "miniz",
    "cgal",
    {
      "name": "opencascade",
      "default-features": false
    },
    "opensubdiv"
  ],
  "default-features": [
    "tests"
  ],
  "features": {
    "tests": {
      "description": "Dependencies of the test suite",
      "dependencies": [
        "catch2"
      ]
    },
    "app": {
      "description": "Qt 6 for the desktop app (slow to build; the Qt installer is an alternative, see README)",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "gui",
            "widgets",
            "opengl",
            "network"
          ]
        }
      ]
    }
  }
}
