# Auto detect text files and perform LF normalization
* text=auto

# Golden scans are large binary files (tests/golden/README.md)
tests/golden/**/*.stl filter=lfs diff=lfs merge=lfs -text
tests/golden/**/*.obj filter=lfs diff=lfs merge=lfs -text
tests/golden/**/*.ply filter=lfs diff=lfs merge=lfs -text
